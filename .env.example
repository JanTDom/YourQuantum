# ===========================================================================
# YourQuantum V2 — Environment Configuration Template
# All secret values must be provided securely. Never commit real secrets.
# ===========================================================================

# Master API Secret for privileged engine routes (/auth/session, /admin, /jobs)
# Required in production. Generate a strong 32+ character random string.
YQ_MASTER_API_SECRET=

# Google Gemini API Key for Cognitive Perception & Intake (Gemini 2.5 Flash)
# If omitted, system runs with deterministic semantic offline fallback.
GEMINI_API_KEY=

# MCP Server Credentials
YQ_API_KEY=
YQ_API_BASE_URL=https://yourquantum.pl

# Web Research & Evidence Search Providers (Phase C)
# Optional — if omitted, web research uses direct URL fetching and public fixtures.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# Security, Quota & Rate Limiting Guards (Phase H)
RATE_LIMIT_ENABLED=true
MAX_DAILY_REQUESTS_ANON=60
MAX_DAILY_REQUESTS_AUTH=600
MAX_GLOBAL_DAILY_CALLS=600
SESSION_HMAC_SECRET=

# Physical QPU Backends (Phase F — Optional hardware execution)
# If omitted, quantum algorithms run in CPU simulation mode (Qiskit Aer).
IBM_QUANTUM_TOKEN=
AWS_BRAKET_ACCESS_KEY=
AWS_BRAKET_SECRET_KEY=
